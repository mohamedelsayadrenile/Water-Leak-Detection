signal_source_columns=["water_level","pressure_level"]
signal_column=signal
sampling_interval_seconds=300
sensor_deadband=0.005
rolling_window=5
refill_consecutive_pos=3
min_event_samples=2
idle_gap_minutes=15
low_activity_percentile=33.0
night_hours=[23, 0, 1, 2, 3, 4, 5]
rule_a_min_unusual_prob=0.25
rule_a_dur_mult=1.5
rule_b_min_quiet_hours=4.0
rule_b_slope_mult=2.0
rule_b_step_minutes=60
rule_c_max_duration_hours=4.0
rule_min_score=0.3
leak_confidence_threshold=0.5
severity_medium_threshold=0.6
severity_high_threshold=0.85
profile_dir=data/profiles
uploads_dir=data/uploads
keep_failed_uploads=true
min_learn_days=25
min_detect_minutes=1440
max_upload_mb=50
task_timeout_minutes=60
sweep_stale_tasks_on_startup=true
log_level=INFO
